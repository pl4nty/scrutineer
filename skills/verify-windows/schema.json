{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "verify-windows report",
  "type": "object",
  "required": [
    "status",
    "artifact",
    "attack_tree",
    "attempts",
    "criteria"
  ],
  "additionalProperties": false,
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "confirmed",
        "fixed",
        "inconclusive",
        "deferred",
        "not_attempted"
      ],
      "description": "confirmed = all three attempts reproduce and all criteria pass; fixed = all three attempts reach current code without reproducing; inconclusive = execution leaves conflicting evidence; deferred = external-reach preflight prevents execution; not_attempted = setup never reaches the target."
    },
    "preflight": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "classification": {
          "type": "string",
          "enum": [
            "local-safe",
            "external-reach"
          ],
          "description": "local-safe uses only local input, loopback and workspace/temp writes; external-reach contacts another host, reads credentials or writes outside those locations."
        },
        "justification": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "description": "The exact lines from the reproduction that decided the classification, quoted verbatim."
        }
      },
      "required": [
        "classification",
        "justification"
      ]
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provenance",
        "install_mode",
        "head_correspondence",
        "reimplementation_free",
        "execution_target",
        "authored_files",
        "system_changes"
      ],
      "description": "What was actually executed and where it came from. A verification whose execution target is not a shipped artifact or a build from the project's own toolchain cannot be confirmed.",
      "properties": {
        "provenance": {
          "type": "string",
          "enum": [
            "released-binary",
            "package-registry",
            "source-build",
            "none"
          ],
          "description": "released-binary = an asset from the publisher's own release; package-registry = the published package restored from its registry; source-build = built from ./src with the project's own toolchain because no release carried the vulnerable code; none = nothing was obtained (only valid with status not_attempted or deferred)."
        },
        "install_mode": {
          "type": "string",
          "enum": [
            "extracted",
            "installed",
            "package-restore",
            "source-build",
            "none"
          ],
          "description": "How the artifact reached disk. installed means machine state was changed and requires the SCRUTINEER_WINDOWS_INSTALL opt-in plus an uninstall entry in system_changes."
        },
        "head_correspondence": {
          "type": "string",
          "enum": [
            "tested-artifact-equals-head",
            "tested-artifact-predates-head",
            "tested-artifact-postdates-head",
            "unknown"
          ],
          "description": "Relationship between what was executed and the scanned commit. Only tested-artifact-equals-head can support a fixed verdict; a clean older release says nothing about HEAD."
        },
        "reimplementation_free": {
          "type": "boolean",
          "description": "True only when no authored file computes what the target computes: deleting every authored file must leave the vulnerability in the product."
        },
        "fallback_reason": {
          "type": "string",
          "description": "Why a release binary was not used; empty when one was."
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "release_tag": {
              "type": "string"
            },
            "release_url": {
              "type": "string"
            },
            "asset_name": {
              "type": "string"
            },
            "download_url": {
              "type": "string"
            },
            "sha256": {
              "type": "string"
            },
            "publisher_checksum": {
              "type": "string",
              "enum": [
                "matched",
                "absent",
                "mismatched",
                "unchecked"
              ]
            },
            "authenticode": {
              "type": "string",
              "enum": [
                "valid",
                "unsigned",
                "invalid",
                "unchecked"
              ]
            },
            "signer": {
              "type": "string"
            },
            "ancestry": {
              "type": "string",
              "description": "Evidence that the chosen tag is at or behind the scanned commit."
            },
            "contains_vulnerable_code": {
              "type": "string",
              "description": "Evidence that the vulnerable code is present in the chosen tag, by content rather than by date."
            },
            "build_commands": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "For source-build provenance: the project's own build invocation, verbatim."
            },
            "built_commit": {
              "type": "string"
            }
          }
        },
        "execution_target": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "description": "Full path of the image that ran. Must resolve inside the install root, package cache, or build output - never inside ./src or an authored file."
            },
            "sha256": {
              "type": "string"
            },
            "file_version": {
              "type": "string"
            },
            "assembly_version": {
              "type": "string"
            },
            "symbols": {
              "type": "string",
              "enum": [
                "shipped",
                "downloaded",
                "built",
                "absent"
              ]
            }
          }
        },
        "authored_files": {
          "type": "array",
          "description": "Every file written for this verification, each justified as input, driver, harness or observer. A file that re-implements target logic has no legitimate role here.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "role",
              "why"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "role": {
                "type": "string",
                "enum": [
                  "input",
                  "driver",
                  "harness",
                  "observer"
                ]
              },
              "why": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            }
          }
        },
        "toolchain": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Interpreters, debuggers and capture tools used, with versions."
        },
        "system_changes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "description": "Every mutation made to the host and how it was undone. Record the no-change case explicitly rather than leaving the list empty."
        }
      }
    },
    "attack_tree": {
      "$ref": "#/$defs/attackTree"
    },
    "attempts": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/attempt"
      }
    },
    "criteria": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "poc_well_formed",
        "reproduces_three_of_three",
        "claimed_failure_class",
        "public_interface_to_first_party_sink",
        "deterministic",
        "control_bypass"
      ],
      "properties": {
        "poc_well_formed": {
          "$ref": "#/$defs/criterion"
        },
        "reproduces_three_of_three": {
          "$ref": "#/$defs/criterion"
        },
        "claimed_failure_class": {
          "$ref": "#/$defs/criterion"
        },
        "public_interface_to_first_party_sink": {
          "$ref": "#/$defs/criterion"
        },
        "deterministic": {
          "$ref": "#/$defs/criterion"
        },
        "control_bypass": {
          "$ref": "#/$defs/controlBypass"
        }
      }
    },
    "reproducer": {
      "type": "string",
      "description": "The exact reproduction run against ./src: script, commands, and crafted input, verbatim."
    },
    "evidence": {
      "type": "string",
      "description": "Relevant stdout, stderr, exit codes, traces, and observed behavior across the attempts."
    },
    "notes": {
      "type": "string"
    }
  },
  "$defs": {
    "attackTree": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "goal",
        "root_id",
        "verdict",
        "nodes",
        "blockers"
      ],
      "properties": {
        "goal": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "description": "The claimed attacker-visible security effect being tested."
        },
        "root_id": {
          "type": "string",
          "pattern": "^AT[1-9][0-9]*$",
          "description": "ID of the single root goal node. Semantic validation requires it to exist and have a null parent_id."
        },
        "verdict": {
          "type": "string",
          "enum": [
            "reachable",
            "blocked",
            "unproven",
            "not_attempted"
          ],
          "description": "Whether the complete supplied attack path reached its claimed effect, was stopped by a concrete dominant blocker, remains unproved, or could not be evaluated."
        },
        "nodes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/attackTreeNode"
          }
        },
        "blockers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "uniqueItems": true,
          "description": "Concrete guards or unmet preconditions that block the supplied path; empty when no blocker was established."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "verdict": {
                "const": "blocked"
              }
            },
            "required": [
              "verdict"
            ]
          },
          "then": {
            "properties": {
              "blockers": {
                "minItems": 1
              },
              "nodes": {
                "contains": {
                  "properties": {
                    "status": {
                      "const": "blocked"
                    }
                  },
                  "required": [
                    "status"
                  ]
                },
                "minContains": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "verdict": {
                "const": "reachable"
              }
            },
            "required": [
              "verdict"
            ]
          },
          "then": {
            "properties": {
              "blockers": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
    "attackTreeNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "parent_id",
        "kind",
        "description",
        "status",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^AT[1-9][0-9]*$"
        },
        "parent_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^AT[1-9][0-9]*$",
          "description": "Parent node ID, or null for the root goal only."
        },
        "kind": {
          "type": "string",
          "enum": [
            "goal",
            "precondition",
            "entry_point",
            "transition",
            "trust_boundary",
            "sink",
            "effect"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "status": {
          "type": "string",
          "enum": [
            "satisfied",
            "blocked",
            "unproven",
            "not_attempted"
          ]
        },
        "evidence": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "description": "Source location, command output, attempt result, concrete blocker, or reason evaluation could not start."
        }
      }
    },
    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "number",
        "outcome",
        "evidence",
        "failure_class",
        "crash_site"
      ],
      "properties": {
        "number": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "outcome": {
          "type": "string",
          "enum": [
            "reproduced",
            "not_reproduced",
            "not_attempted"
          ],
          "description": "Whether this independent run reproduced the claimed failure, reached the target without it, or never reached the target."
        },
        "evidence": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "description": "Attempt-specific output, or the concrete reason this attempt could not start."
        },
        "failure_class": {
          "type": "string",
          "description": "Observed failure class; empty when no target failure occurred."
        },
        "crash_site": {
          "type": "string",
          "description": "First-party crash/sink site; empty when it could not be established."
        }
      }
    },
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verdict",
        "method",
        "evidence",
        "counterevidence",
        "proof_gap",
        "confidence"
      ],
      "properties": {
        "verdict": {
          "type": "string",
          "enum": [
            "pass",
            "fail",
            "not_attempted"
          ]
        },
        "method": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "description": "How this criterion was checked, such as executing the PoC, tracing the stack or inspecting callers."
        },
        "evidence": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "description": "Positive facts supporting this criterion's verdict."
        },
        "counterevidence": {
          "type": "string",
          "description": "Facts that weaken or contradict the verdict; empty only when none were found."
        },
        "proof_gap": {
          "type": "string",
          "description": "What could not be established and what evidence would resolve it; empty only when there is no gap."
        },
        "confidence": {
          "type": "string",
          "enum": [
            "high",
            "medium",
            "low"
          ],
          "description": "Confidence in this criterion's verdict based on the recorded method and evidence."
        }
      }
    },
    "controlBypass": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "matched_controls",
        "assessments"
      ],
      "properties": {
        "matched_controls": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "uniqueItems": true,
          "description": "The exact control IDs supplied by scrutineer.controls.ids; empty when no controls were matched or no controls block was staged."
        },
        "assessments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/controlAssessment"
          },
          "description": "Exactly one assessment for every matched control. The worker enforces ID set equality and uniqueness."
        },
        "unavailable_reason": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "description": "The exact scrutineer.controls.unavailable_reason staged by the host when control resolution failed; omitted when resolution succeeded or no controls exist."
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "unavailable_reason"
            ]
          },
          "then": {
            "properties": {
              "matched_controls": {
                "maxItems": 0
              },
              "assessments": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
    "controlAssessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "control_id",
        "disposition",
        "evidence"
      ],
      "properties": {
        "control_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "disposition": {
          "type": "string",
          "enum": [
            "bypassed",
            "held",
            "not_applicable",
            "unresolved",
            "not_attempted"
          ],
          "description": "bypassed = execution defeated the claimed control; held = evidenced control enforcement blocked the path; not_applicable = evidence shows the matched control does not govern this path; unresolved = neither bypass nor enforcement was established; not_attempted = evaluation could not start."
        },
        "evidence": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "description": "Concrete bypass or enforcement evidence, the reason the control does not apply, or the proof gap preventing assessment."
        }
      }
    },
    "notAttemptedCriteria": {
      "type": "object",
      "properties": {
        "poc_well_formed": {
          "properties": {
            "verdict": {
              "const": "not_attempted"
            }
          }
        },
        "reproduces_three_of_three": {
          "properties": {
            "verdict": {
              "const": "not_attempted"
            }
          }
        },
        "claimed_failure_class": {
          "properties": {
            "verdict": {
              "const": "not_attempted"
            }
          }
        },
        "public_interface_to_first_party_sink": {
          "properties": {
            "verdict": {
              "const": "not_attempted"
            }
          }
        },
        "deterministic": {
          "properties": {
            "verdict": {
              "const": "not_attempted"
            }
          }
        },
        "control_bypass": {
          "properties": {
            "assessments": {
              "items": {
                "properties": {
                  "disposition": {
                    "const": "not_attempted"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "deferred"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "preflight"
        ],
        "properties": {
          "preflight": {
            "properties": {
              "classification": {
                "const": "external-reach"
              }
            }
          },
          "attempts": {
            "items": {
              "properties": {
                "outcome": {
                  "const": "not_attempted"
                }
              }
            }
          },
          "criteria": {
            "$ref": "#/$defs/notAttemptedCriteria"
          },
          "attack_tree": {
            "properties": {
              "verdict": {
                "const": "not_attempted"
              },
              "nodes": {
                "items": {
                  "properties": {
                    "status": {
                      "const": "not_attempted"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "not_attempted"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "attempts": {
            "items": {
              "properties": {
                "outcome": {
                  "const": "not_attempted"
                }
              }
            }
          },
          "criteria": {
            "$ref": "#/$defs/notAttemptedCriteria"
          },
          "attack_tree": {
            "properties": {
              "verdict": {
                "const": "not_attempted"
              },
              "nodes": {
                "items": {
                  "properties": {
                    "status": {
                      "const": "not_attempted"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "confirmed"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "attempts": {
            "items": {
              "properties": {
                "outcome": {
                  "const": "reproduced"
                }
              }
            }
          },
          "criteria": {
            "properties": {
              "poc_well_formed": {
                "properties": {
                  "verdict": {
                    "const": "pass"
                  }
                }
              },
              "reproduces_three_of_three": {
                "properties": {
                  "verdict": {
                    "const": "pass"
                  }
                }
              },
              "claimed_failure_class": {
                "properties": {
                  "verdict": {
                    "const": "pass"
                  }
                }
              },
              "public_interface_to_first_party_sink": {
                "properties": {
                  "verdict": {
                    "const": "pass"
                  }
                }
              },
              "deterministic": {
                "properties": {
                  "verdict": {
                    "const": "pass"
                  }
                }
              },
              "control_bypass": {
                "properties": {
                  "assessments": {
                    "items": {
                      "properties": {
                        "disposition": {
                          "enum": [
                            "bypassed",
                            "not_applicable"
                          ]
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "attack_tree": {
            "properties": {
              "verdict": {
                "const": "reachable"
              },
              "nodes": {
                "allOf": [
                  {
                    "contains": {
                      "properties": {
                        "kind": {
                          "const": "entry_point"
                        }
                      },
                      "required": [
                        "kind"
                      ]
                    },
                    "minContains": 1
                  },
                  {
                    "contains": {
                      "properties": {
                        "kind": {
                          "const": "sink"
                        }
                      },
                      "required": [
                        "kind"
                      ]
                    },
                    "minContains": 1
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "fixed"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "attempts": {
            "items": {
              "properties": {
                "outcome": {
                  "const": "not_reproduced"
                }
              }
            }
          },
          "criteria": {
            "properties": {
              "reproduces_three_of_three": {
                "properties": {
                  "verdict": {
                    "const": "fail"
                  }
                }
              },
              "control_bypass": {
                "properties": {
                  "assessments": {
                    "items": {
                      "properties": {
                        "disposition": {
                          "enum": [
                            "bypassed",
                            "held",
                            "not_applicable"
                          ]
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "attack_tree": {
            "properties": {
              "verdict": {
                "const": "blocked"
              },
              "blockers": {
                "minItems": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "inconclusive"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "attack_tree": {
            "properties": {
              "verdict": {
                "enum": [
                  "blocked",
                  "unproven"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "confirmed"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "artifact": {
            "properties": {
              "provenance": {
                "enum": [
                  "released-binary",
                  "package-registry",
                  "source-build"
                ]
              },
              "reimplementation_free": {
                "const": true
              },
              "execution_target": {
                "properties": {
                  "sha256": {
                    "minLength": 64
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "fixed"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "artifact": {
            "properties": {
              "provenance": {
                "enum": [
                  "released-binary",
                  "package-registry",
                  "source-build"
                ]
              },
              "head_correspondence": {
                "const": "tested-artifact-equals-head"
              }
            }
          }
        }
      }
    }
  ]
